-                {
-                    if (distBuff[i] > maxd2) { maxd2 = distBuff[i]; maxIdx = i; }
-                }
-                if (dist2 < maxd2) { distBuff[maxIdx] = dist2; }
-            }
-            float score = 0;
-            size_t nhits = 0;
-            for (size_t i = 0; i < distBuff.size(); ++i )
