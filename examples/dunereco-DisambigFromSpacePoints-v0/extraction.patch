+++ b/dunereco/HitFinderDUNE/DisambigFromSpacePointsAlg.cxx
@@ -0,0 +1,289 @@
+#include "dunereco/HitFinderDUNE/DisambigFromSpacePointsAlg.h"
+
+#include <algorithm>
+#include <cmath>
+// PHLEX-TRANSITIONAL: logging
+#include "messagefacility/MessageLogger/MessageLogger.h"
+// ^ mf::LogWarning calls below stay inline in the algorithm (see
+// references/larsoft-boundary-patterns.md, "Logging and exceptions");
+// Phlex has not settled on a logging facility. See MIGRATION_NOTES.md
+// section 6.
+
+namespace dune {
+
+  std::unordered_map<size_t, size_t> BuildSpacePointToTPCMap(
+    std::vector<std::vector<recob::Hit const*>> const& hitsPerSpacePoint)
+  {
+    // map induction spacepoints to TPC by collection hits
+    std::unordered_map<size_t, size_t> spToTPC;
+    for (size_t i = 0; i < hitsPerSpacePoint.size(); ++i)
+    {
+        auto const& hits = hitsPerSpacePoint[i];
+        size_t tpc = geo::WireID::InvalidID;
+        for (const auto & h : hits) // find Collection hit, assume one is enough
+        {
+            if (h->SignalType() == geo::kCollection) { tpc = h->WireID().TPC; break; }
+        }
+        if (tpc == geo::WireID::InvalidID)
+        {
+          //mf::LogWarning("DisambigFromSpacePoints") << "No collection hit for this spacepoint.";
+            continue;
+        }
+        for (const auto & h : hits) // set mapping for Induction hits
+        {
+            if (h->SignalType() == geo::kInduction) { spToTPC[i] = tpc; }
+        }
+    }
+    return spToTPC;
+  }
+
+  int RunOnSpacePoints(geo::WireReadoutGeom const& wireReadout,
+                       std::vector<recob::Hit> const& eventHits,
+                       std::vector<std::vector<recob::SpacePoint const*>> const& spacePointsPerHit,
+                       std::vector<std::vector<size_t>> const& spKeysPerHit,
+                       std::unordered_map<size_t, size_t> const& spToTPC,
+                       std::unordered_map<size_t, geo::WireID>& assignments,
+                       cryo_tpc_plane_keymap& indHits,
+                       std::vector<size_t>& unassigned,
+                       DisambigStats& stats)
+  {
+    stats.nHits[0] = 0; stats.nHits[1] = 0; stats.nHits[2] = 0;
+    stats.nMissedBySpacePoints[0] = 0;
+    stats.nMissedBySpacePoints[1] = 0;
+
+    for (size_t i = 0; i < eventHits.size(); ++i)
+    {
+        recob::Hit const& hit = eventHits[i];
+        std::vector<geo::WireID> cwids = wireReadout.ChannelToWire(hit.Channel());
+        // PHLEX-TRANSITIONAL: logging
+        if (cwids.empty()) { mf::LogWarning("DisambigFromSpacePoints") << "No wires for this channel???"; continue; }
+        if (hit.SignalType() == geo::kCollection)
+        {
+            assignments[i] = cwids.front();
+            stats.nHits[2]++; // count collection hit
+        }
+        else
+        {
+            geo::WireID id = hit.WireID();
+            size_t cryo = id.Cryostat, plane = id.Plane;
+            stats.nHits[plane]++; // count induction hit
+
+            auto const& spKeys = spKeysPerHit[i];
+            auto const& spacePoints = spacePointsPerHit[i];
+            if (spKeys.size() == 0)
+            {
+                unassigned.push_back(i);
+                stats.nMissedBySpacePoints[plane]++; //count unresolved hit
+            }
+            else
+            {
+                std::unordered_map< size_t, geo::WireID > tpcBestWire;
+                std::unordered_map< size_t, size_t > tpcScore;
+
+                for (size_t s = 0; s < spKeys.size(); ++s)
+                {
+                    auto search = spToTPC.find(spKeys[s]);
+                    if (search == spToTPC.end()) { continue; }
+                    size_t spTpc = search->second;
+
+                    const float max_dw = 1.; // max dist to wire [wire pitch]
+                    for (size_t w = 0; w < cwids.size(); ++w)
+                    {
+                        if (cwids[w].TPC != spTpc) { continue; } // not that side of APA
+
+                        float sp_wire = wireReadout.Plane(cwids[w]).WireCoordinate(spacePoints[s]->position());
+                        float dw = std::fabs(sp_wire - cwids[w].Wire);
+                        if (dw < max_dw)
+                        {
+                            tpcBestWire[spTpc] = cwids[w];
+                            tpcScore[spTpc]++;
+                        }
+                    }
+                }
+                if (!tpcScore.empty())
+                {
+                    geo::WireID bestId;
+                    size_t maxScore = 0;
+                    for (const auto & score : tpcScore)
+                    {
+                        if (score.second > maxScore)
+                        {
+                            maxScore = score.second;
+                            bestId = tpcBestWire[score.first];
+                        }
+                    }
+                    indHits[cryo][bestId.TPC][plane].push_back(i);
+                    assignments[i] = bestId;
+                }
+                else
+                {
+                  //mf::LogWarning("DisambigFromSpacePoints") << "Did not find matching wire (plane:" << plane << ").";
+                    unassigned.push_back(i);
+                    stats.nMissedBySpacePoints[plane]++; //count unresolved hit
+                }
+            }
+        }
+    }
+
+    return stats.nMissedBySpacePoints[0] + stats.nMissedBySpacePoints[1];
+  }
+
+  int ResolveUnassigned(DisambigFromSpacePointsCfg const& cfg,
+                        geo::WireReadoutGeom const& wireReadout,
+                        detinfo::DetectorPropertiesData const& detProp,
+                        std::unordered_map<size_t, geo::WireID>& assignments,
+                        std::vector<recob::Hit> const& eventHits,
+                        cryo_tpc_plane_keymap& allIndHits,
+                        std::vector<size_t>& unassigned,
+                        size_t nNeighbors,
+                        DisambigStats& stats)
+  {
+    stats.nMissedByNeighbors[0] = 0;
+    stats.nMissedByNeighbors[1] = 0;
+
+    std::unordered_map< size_t, geo::WireID > result;
+
+    for (const size_t key : unassigned)
+    {
+        recob::Hit const& hit = eventHits[key];
+        geo::WireID id = hit.WireID();
+        unsigned int cryo = id.Cryostat, plane = id.Plane;
+        float hitDrift = hit.PeakTime();
+
+        std::vector<geo::WireID> cwids = wireReadout.ChannelToWire(hit.Channel());
+        // PHLEX-TRANSITIONAL: logging
+        if (cwids.empty()) { mf::LogWarning("DisambigFromSpacePoints") << "No wires for this channel???"; continue; }
+
+        const float dwMax = cfg.maxDistance / wireReadout.Plane({0, 0, plane}).WirePitch(); // max distance in wires to look for neighbors
+        const float ddMax = dwMax * wireReadout.Plane({0, 0, plane}).WirePitch() / std::fabs(detProp.GetXTicksCoefficient(0, 0));
+
+        float bestScore = 0;
+        geo::WireID bestId;
+        for (size_t w = 0; w < cwids.size(); ++w)
+        {
+            const size_t tpc = cwids[w].TPC;
+            const size_t hitWire = cwids[w].Wire;
+
+            bool allowed = true;
+            for (auto t : cfg.excludeTPCs) { if (t == tpc) { allowed = false; break; } }
+            if (!allowed) { continue; }
+
+            geo::PlaneID const planeID(cryo, tpc, plane);
+            const float wirePitch = wireReadout.Plane(planeID).WirePitch();
+            const float driftPitch = std::fabs(detProp.GetXTicksCoefficient(tpc, cryo));
+
+            float maxDValue = cfg.maxDistance*cfg.maxDistance;
+            std::vector<float> distBuff(nNeighbors, maxDValue); // distance to n closest hits
+            const auto & keys = allIndHits[cryo][tpc][plane];
+            for (const size_t keyInd : keys)
+            {
+                recob::Hit const& hitInd = eventHits[keyInd];
+
+                auto search = assignments.find(keyInd);        // find resolved wire id
+                if (search == assignments.end())
+                {
+                    // PHLEX-TRANSITIONAL: logging
+                    mf::LogWarning("DisambigFromSpacePoints") << "Did not find resolved wire id.";
+                    continue;
+                }
+
+                //float dWire = std::abs(hitWire - search->second.Wire);
+                float dWire = std::abs(float(hitWire) - float(search->second.Wire));
+                float dDrift = std::fabs(hitDrift - hitInd.PeakTime());
+
+                if ((dWire > dwMax) || (dDrift > ddMax)) { continue; }
+
+                dWire *= wirePitch;
+                dDrift *= driftPitch;
+                float dist2 = dWire * dWire + dDrift * dDrift;
+
+                float maxd2 = 0;
+                size_t maxIdx = 0;
+                for (size_t i = 0; i < distBuff.size(); ++i )
+                {
+                    if (distBuff[i] > maxd2) { maxd2 = distBuff[i]; maxIdx = i; }
+                }
+                if (dist2 < maxd2) { distBuff[maxIdx] = dist2; }
+            }
+            float score = 0;
+            size_t nhits = 0;
+            for (size_t i = 0; i < distBuff.size(); ++i )
+            {
+                if (distBuff[i] < maxDValue) { score += 1./(1. + distBuff[i]); ++nhits; }
+            }
+            if (nhits > 0)
+            {
+                if (score > bestScore)
+                {
+                    bestScore = score;
+                    bestId = cwids[w];
+                }
+            }
+        }
+        if (bestId.isValid) { result[key] = bestId; }
+        else { stats.nMissedByNeighbors[plane]++; }
+    }
+
+    // remove from list of unassigned hits
+    for (const auto & entry : result)
+    {
+        unassigned.erase(std::remove(unassigned.begin(), unassigned.end(), entry.first), unassigned.end());
+    }
+
+    //assignments.merge(result); // use this with C++ 17
+    assignments.insert(result.begin(), result.end());
+    return stats.nMissedByNeighbors[0] + stats.nMissedByNeighbors[1];
+  }
+
+  void AssignFirstAllowedWire(DisambigFromSpacePointsCfg const& cfg,
+                              geo::WireReadoutGeom const& wireReadout,
+                              std::unordered_map<size_t, geo::WireID>& assignments,
+                              std::vector<recob::Hit> const& eventHits,
+                              std::vector<size_t> const& unassigned)
+  {
+    for (const size_t key : unassigned)
+    {
+        recob::Hit const& hit = eventHits[key];
+        std::vector<geo::WireID> cwids = wireReadout.ChannelToWire(hit.Channel());
+        // PHLEX-TRANSITIONAL: logging
+        if (cwids.empty()) { mf::LogWarning("DisambigFromSpacePoints") << "No wires for this channel???"; continue; }
+
+        geo::WireID bestId;
+        for (size_t w = 0; w < cwids.size(); ++w)
+        {
+            const size_t tpc = cwids[w].TPC;
+
+            bool allowed = true;
+            for (auto t : cfg.excludeTPCs) { if (t == tpc) { allowed = false; break; } }
+            if (allowed) { bestId = cwids[w]; break; }
+        }
+        if (bestId.isValid) { assignments[key] = bestId; }
+        // PHLEX-TRANSITIONAL: logging
+        else { mf::LogWarning("DisambigFromSpacePoints") << "None of wires is allowed for this hit???"; }
+    }
+  }
+
+  void AssignEveryAllowedWire(DisambigFromSpacePointsCfg const& cfg,
+                              geo::WireReadoutGeom const& wireReadout,
+                              std::unordered_map<size_t, std::vector<geo::WireID>>& assignments,
+                              std::vector<recob::Hit> const& eventHits,
+                              std::vector<size_t> const& unassigned)
+  {
+    for (const size_t key : unassigned)
+    {
+        recob::Hit const& hit = eventHits[key];
+        std::vector<geo::WireID> cwids = wireReadout.ChannelToWire(hit.Channel());
+        if (cwids.empty()) { continue; } // add warning here -- PHLEX pass 1: pre-existing gap, see MIGRATION_NOTES.md section 4
+
+        for (size_t w = 0; w < cwids.size(); ++w)
+        {
+            const size_t tpc = cwids[w].TPC;
+
+            bool allowed = true;
+            for (auto t : cfg.excludeTPCs) { if (t == tpc) { allowed = false; break; } }
+            if (allowed) { assignments[key].push_back(cwids[w]); }
+        }
+    }
+  }
+
+} // namespace dune
diff --git a/dunereco/HitFinderDUNE/DisambigFromSpacePointsAlg.h b/dunereco/HitFinderDUNE/DisambigFromSpacePointsAlg.h
