@@ -0,0 +1,127 @@
+#ifndef DUNERECO_HITFINDERDUNE_DISAMBIGFROMSPACEPOINTSALG_H
+#define DUNERECO_HITFINDERDUNE_DISAMBIGFROMSPACEPOINTSALG_H
+
+////////////////////////////////////////////////////////////////////////
+//
+// DisambigFromSpacePoints algorithm (framework-free)
+//
+// Extracted from DisambigFromSpacePoints_module.cc (R.Sulej): assign a
+// wire to each hit using SpacePoints created by SpacePointSolver, then
+// resolve any hits left undisambiguated using neighboring hits.
+//
+// Phlex pass 1 extraction. See runs/dunereco-DisambigFromSpacePoints/
+// MIGRATION_NOTES.md in the art-to-phlex-agents kit for the separation
+// and extraction rationale.
+//
+////////////////////////////////////////////////////////////////////////
+
+#include <cstddef>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "larcorealg/Geometry/WireReadoutGeom.h"
+#include "larcoreobj/SimpleTypesAndConstants/geo_types.h"
+#include "lardataalg/DetectorInfo/DetectorPropertiesData.h"
+#include "lardataobj/RecoBase/Hit.h"
+#include "lardataobj/RecoBase/SpacePoint.h"
+
+// Deep diagnostic messages inside the algorithm use mf::LogWarning; the
+// messagefacility include and its PHLEX-TRANSITIONAL marker live in
+// DisambigFromSpacePointsAlg.cxx (the only translation unit that uses
+// mf::), not here, so an includer of this header does not also pull in
+// messagefacility. See MIGRATION_NOTES.md section 6.
+
+namespace dune {
+
+  // these types to be replaced with use of feature proposed in redmine #12602
+  // (moved verbatim from DisambigFromSpacePoints_module.cc)
+  typedef std::map<unsigned int, std::vector<size_t>> plane_keymap;
+  typedef std::map<unsigned int, plane_keymap> tpc_plane_keymap;
+  typedef std::map<unsigned int, tpc_plane_keymap> cryo_tpc_plane_keymap;
+
+  /// Configuration consumed by the algorithm functions below. Holds only
+  /// the FHiCL-sourced values the computation itself reads; input labels,
+  /// UseNeighbors, and MoveLeftovers stay at the module boundary because
+  /// they select *which* of these functions to call, not what any one of
+  /// them computes. Defaults live only in the module's FHiCL lookup.
+  struct DisambigFromSpacePointsCfg {
+    float maxDistance;
+    std::vector<size_t> excludeTPCs;
+  };
+
+  /// Per-event diagnostics, filled into the module's monitoring TTree
+  /// when MonitoringPlots is set. Replaces the module's fNHits and
+  /// fNMissedBySpacePoints data members, which RunOnSpacePoints reset at
+  /// the start of every call anyway, and its fNMissedByNeighbors member,
+  /// which ResolveUnassigned resets at the start of every call -- but
+  /// ResolveUnassigned only runs when UseNeighbors is set. The module
+  /// copies nMissedByNeighbors into fNMissedByNeighbors only in that same
+  /// case, to preserve the original's (buggy, pre-existing, not fixed
+  /// here) behaviour of never writing that branch at all otherwise.
+  struct DisambigStats {
+    int nHits[3] = {0, 0, 0};
+    int nMissedBySpacePoints[2] = {0, 0};
+    int nMissedByNeighbors[2] = {0, 0};
+  };
+
+  /// Maps each SpacePoint index (its key in the SpacePoint collection) to
+  /// the TPC of that SpacePoint's collection-plane hit, so induction hits
+  /// can be matched to SpacePoints on the correct side of the APA.
+  /// hitsPerSpacePoint[i] holds the hits associated with SpacePoint i
+  /// (resolved from the module's hit<->SpacePoint association).
+  std::unordered_map<size_t, size_t> BuildSpacePointToTPCMap(
+    std::vector<std::vector<recob::Hit const*>> const& hitsPerSpacePoint);
+
+  /// Assigns a wire to every hit whose associated SpacePoints resolve to
+  /// a single best wire. Collection-plane hits are assigned directly from
+  /// geometry. spacePointsPerHit[i] / spKeysPerHit[i] are, respectively,
+  /// the SpacePoints and their SpacePoint-collection keys associated with
+  /// eventHits[i] (resolved from the module's hit<->SpacePoint
+  /// association; the key is needed to look up spToTPC).
+  /// Returns the number of induction hits left undisambiguated. Takes no
+  /// DisambigFromSpacePointsCfg: this step uses only geometry, unlike
+  /// ResolveUnassigned and the AssignXWire functions below.
+  int RunOnSpacePoints(geo::WireReadoutGeom const& wireReadout,
+                       std::vector<recob::Hit> const& eventHits,
+                       std::vector<std::vector<recob::SpacePoint const*>> const& spacePointsPerHit,
+                       std::vector<std::vector<size_t>> const& spKeysPerHit,
+                       std::unordered_map<size_t, size_t> const& spToTPC,
+                       std::unordered_map<size_t, geo::WireID>& assignments,
+                       cryo_tpc_plane_keymap& indHits,
+                       std::vector<size_t>& unassigned,
+                       DisambigStats& stats);
+
+  /// Resolves hits listed in `unassigned` using the wire already assigned
+  /// to nearby hits recorded in `allIndHits` (built by RunOnSpacePoints).
+  /// Returns the number of hits still unresolved after this step.
+  int ResolveUnassigned(DisambigFromSpacePointsCfg const& cfg,
+                        geo::WireReadoutGeom const& wireReadout,
+                        detinfo::DetectorPropertiesData const& detProp,
+                        std::unordered_map<size_t, geo::WireID>& assignments,
+                        std::vector<recob::Hit> const& eventHits,
+                        cryo_tpc_plane_keymap& allIndHits,
+                        std::vector<size_t>& unassigned,
+                        size_t nNeighbors,
+                        DisambigStats& stats);
+
+  /// Puts every hit listed in `unassigned` on the first allowed wire
+  /// (MoveLeftovers == "first").
+  void AssignFirstAllowedWire(DisambigFromSpacePointsCfg const& cfg,
+                              geo::WireReadoutGeom const& wireReadout,
+                              std::unordered_map<size_t, geo::WireID>& assignments,
+                              std::vector<recob::Hit> const& eventHits,
+                              std::vector<size_t> const& unassigned);
+
+  /// Duplicates every hit listed in `unassigned` onto every allowed wire
+  /// (MoveLeftovers == "repeat").
+  void AssignEveryAllowedWire(DisambigFromSpacePointsCfg const& cfg,
+                              geo::WireReadoutGeom const& wireReadout,
+                              std::unordered_map<size_t, std::vector<geo::WireID>>& assignments,
+                              std::vector<recob::Hit> const& eventHits,
+                              std::vector<size_t> const& unassigned);
+
+} // namespace dune
+
+#endif
