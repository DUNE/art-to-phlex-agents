@@ -0,0 +1,185 @@
+// Characterization tests for dune::mapSpacePointsToTPC, extracted from
+// DisambigFromSpacePoints_module.cc (base 5d619357).
+//
+// Expected values are traced from the ORIGINAL module, produce() L195-L212:
+//
+//   for i in 0..spHandle->size():
+//     hits = hitsFromSp.at(i)
+//     tpc = InvalidID
+//     first loop:  the first hit with SignalType()==kCollection sets
+//                  tpc = WireID().TPC and ends the loop          (L199-L202)
+//     if tpc == InvalidID: continue                              (L203-L207)
+//     second loop: every hit with SignalType()==kInduction sets
+//                  spToTPC[i] = tpc                              (L208-L212)
+//
+// The algorithm reads only recob::Hit::SignalType() and recob::Hit::WireID().TPC.
+// All other Hit fields are filled with arbitrary values and are never asserted.
+//
+// The tests that need a geometry (disambiguateHits and every pass it runs) are
+// listed as "needs fixture" in TESTS.md: dune::disambiguateHits needs a
+// geo::WireReadoutGeom with a wrapped induction channel map and a
+// detinfo::DetectorPropertiesData, neither of which can be built without a
+// loaded detector geometry.
+
+#define BOOST_TEST_MODULE (DisambigFromSpacePointsAlg_test)
+#include "boost/test/unit_test.hpp"
+
+#include "dunereco/HitFinderDUNE/DisambigFromSpacePointsAlg.h"
+
+#include "larcoreobj/SimpleTypesAndConstants/geo_types.h"
+#include "lardataobj/RecoBase/Hit.h"
+
+#include <cstddef>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+  // Build a hit carrying only the two fields the algorithm reads.
+  recob::Hit makeHit(geo::SigType_t sigType, unsigned int tpc)
+  {
+    geo::View_t const view = (sigType == geo::kCollection) ? geo::kZ : geo::kU;
+    return recob::Hit(/*channel*/ 0, /*start*/ 0, /*end*/ 10, /*peak_time*/ 5.f,
+                      /*sigma_peak_time*/ 1.f, /*rms*/ 1.f, /*peak_amplitude*/ 1.f,
+                      /*sigma_peak_amplitude*/ 1.f, /*ROIsummedADC*/ 1.f, /*HitsummedADC*/ 1.f,
+                      /*hit_integral*/ 1.f, /*hit_sigma_integral*/ 1.f, /*multiplicity*/ 1,
+                      /*local_index*/ 0, /*goodness_of_fit*/ 1.f, /*dof*/ 1, view, sigType,
+                      geo::WireID(/*cryo*/ 0, tpc, /*plane*/ 0, /*wire*/ 0));
+  }
+
+  using HitPtrs = std::vector<recob::Hit const*>;
+  using SpHits = std::vector<HitPtrs>;
+
+} // namespace
+
+BOOST_AUTO_TEST_CASE(no_space_points_gives_empty_map)
+{
+  // L195: the loop body never runs, spToTPC stays empty.
+  SpHits const hitsPerSp;
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.empty());
+}
+
+BOOST_AUTO_TEST_CASE(space_point_without_hits_is_not_mapped)
+{
+  // L195-L207: no hit, first loop finds nothing, tpc == InvalidID, continue.
+  SpHits const hitsPerSp{HitPtrs{}};
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.empty());
+}
+
+BOOST_AUTO_TEST_CASE(collection_and_induction_hit_maps_to_collection_tpc)
+{
+  // L197-L212: collection hit in TPC 3 sets tpc = 3; the induction hit
+  // (WireID TPC 5, deliberately different) then sets spToTPC[0] = 3,
+  // i.e. the TPC comes from the collection hit, not the induction hit.
+  auto const coll = makeHit(geo::kCollection, 3);
+  auto const ind = makeHit(geo::kInduction, 5);
+  SpHits const hitsPerSp{HitPtrs{&ind, &coll}};
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.size() == 1u);
+  BOOST_REQUIRE(map.count(0) == 1u);
+  BOOST_TEST(map.at(0) == 3u);
+}
+
+BOOST_AUTO_TEST_CASE(collection_hit_after_induction_hits_is_still_found)
+{
+  // L199-L202: the first loop scans the whole list until it meets a
+  // collection hit, so its position does not matter; two induction hits come first.
+  auto const ind1 = makeHit(geo::kInduction, 0);
+  auto const ind2 = makeHit(geo::kInduction, 0);
+  auto const coll = makeHit(geo::kCollection, 2);
+  SpHits const hitsPerSp{HitPtrs{&ind1, &ind2, &coll}};
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.size() == 1u);
+  BOOST_REQUIRE(map.count(0) == 1u);
+  BOOST_TEST(map.at(0) == 2u);
+}
+
+BOOST_AUTO_TEST_CASE(first_collection_hit_wins)
+{
+  // L199-L202: "assume one is enough": break after the first collection hit
+  // (TPC 1), so the second one (TPC 4) is ignored.
+  auto const coll1 = makeHit(geo::kCollection, 1);
+  auto const coll2 = makeHit(geo::kCollection, 4);
+  auto const ind = makeHit(geo::kInduction, 0);
+  SpHits const hitsPerSp{HitPtrs{&coll1, &coll2, &ind}};
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_REQUIRE(map.count(0) == 1u);
+  BOOST_TEST(map.at(0) == 1u);
+}
+
+BOOST_AUTO_TEST_CASE(only_induction_hits_is_not_mapped)
+{
+  // L203-L207: no collection hit, tpc stays InvalidID, continue.
+  auto const ind1 = makeHit(geo::kInduction, 0);
+  auto const ind2 = makeHit(geo::kInduction, 1);
+  SpHits const hitsPerSp{HitPtrs{&ind1, &ind2}};
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.empty());
+}
+
+BOOST_AUTO_TEST_CASE(only_collection_hits_is_not_mapped)
+{
+  // L208-L212: tpc is valid but the second loop finds no induction hit, so
+  // nothing is inserted.
+  auto const coll = makeHit(geo::kCollection, 2);
+  SpHits const hitsPerSp{HitPtrs{&coll}};
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.empty());
+}
+
+BOOST_AUTO_TEST_CASE(unknown_signal_type_hits_are_ignored)
+{
+  // kMysteryType is neither kCollection (L201) nor kInduction (L210): a
+  // space point with a mystery hit and an induction hit but no collection hit
+  // is not mapped, and a mystery hit next to a collection+induction pair
+  // changes nothing.
+  auto const mystery = makeHit(geo::kMysteryType, 7);
+  auto const ind = makeHit(geo::kInduction, 0);
+  auto const coll = makeHit(geo::kCollection, 2);
+  SpHits const hitsPerSp{HitPtrs{&mystery, &ind},            // sp 0: no collection -> skipped
+                         HitPtrs{&mystery, &coll, &ind}};    // sp 1: tpc 2
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.size() == 1u);
+  BOOST_TEST(map.count(0) == 0u);
+  BOOST_REQUIRE(map.count(1) == 1u);
+  BOOST_TEST(map.at(1) == 2u);
+}
+
+BOOST_AUTO_TEST_CASE(keys_are_space_point_indices)
+{
+  // L195, L210: the key is the loop index i over space points, so skipped
+  // space points leave gaps: sp 0 -> TPC 1, sp 1 (no hits) skipped,
+  // sp 2 (induction only) skipped, sp 3 -> TPC 0 (TPC 0 is a valid value).
+  auto const collA = makeHit(geo::kCollection, 1);
+  auto const indA = makeHit(geo::kInduction, 1);
+  auto const indB = makeHit(geo::kInduction, 0);
+  auto const collC = makeHit(geo::kCollection, 0);
+  auto const indC = makeHit(geo::kInduction, 0);
+  SpHits const hitsPerSp{HitPtrs{&collA, &indA}, HitPtrs{}, HitPtrs{&indB},
+                         HitPtrs{&indC, &collC}};
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.size() == 2u);
+  BOOST_TEST(map.count(1) == 0u);
+  BOOST_TEST(map.count(2) == 0u);
+  BOOST_REQUIRE(map.count(0) == 1u);
+  BOOST_REQUIRE(map.count(3) == 1u);
+  BOOST_TEST(map.at(0) == 1u);
+  BOOST_TEST(map.at(3) == 0u);
+}
+
+BOOST_AUTO_TEST_CASE(invalid_tpc_on_collection_hit_skips_space_point_quirk)
+{
+  // Oddity (no issue number in the notes): L201-L203 use tpc ==
+  // geo::WireID::InvalidID as the "no collection hit" marker. A collection
+  // hit whose WireID has TPC == InvalidID (here the default WireID) sets tpc to
+  // that same value, so the space point is skipped although a collection hit
+  // exists. Pinned as current behaviour.
+  recob::Hit const collInvalid(0, 0, 10, 5.f, 1.f, 1.f, 1.f, 1.f, 1.f, 1.f, 1.f, 1.f, 1, 0, 1.f,
+                               1, geo::kZ, geo::kCollection, geo::WireID());
+  auto const ind = makeHit(geo::kInduction, 0);
+  SpHits const hitsPerSp{HitPtrs{&collInvalid, &ind}};
+  auto const map = dune::mapSpacePointsToTPC(hitsPerSp);
+  BOOST_TEST(map.empty());
+}
