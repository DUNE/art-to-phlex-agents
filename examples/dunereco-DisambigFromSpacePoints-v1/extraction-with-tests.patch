@@ -0,0 +1,85 @@
+#ifndef DUNERECO_HITFINDERDUNE_DISAMBIGFROMSPACEPOINTSALG_H
+#define DUNERECO_HITFINDERDUNE_DISAMBIGFROMSPACEPOINTSALG_H
+
+////////////////////////////////////////////////////////////////////////
+//
+// DisambigFromSpacePointsAlg
+//
+// Framework-free algorithm extracted from DisambigFromSpacePoints_module.cc
+// (R.Sulej). Put induction hits on the right wire segment using the
+// SpacePoints made from them; resolve hits not disambiguated by SpacePoints
+// using the assignments of neighbouring hits.
+//
+////////////////////////////////////////////////////////////////////////
+
+#include "larcorealg/Geometry/WireReadoutGeom.h"
+#include "larcoreobj/SimpleTypesAndConstants/geo_types.h"
+#include "lardataalg/DetectorInfo/DetectorPropertiesData.h"
+#include "lardataobj/RecoBase/Hit.h"
+#include "lardataobj/RecoBase/SpacePoint.h"
+
+#include <array>
+#include <cstddef>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace dune {
+  // these types to be replaced with use of feature proposed in redmine #12602
+  typedef std::map< unsigned int, std::vector< size_t > > plane_keymap;
+  typedef std::map< unsigned int, plane_keymap > tpc_plane_keymap;
+  typedef std::map< unsigned int, tpc_plane_keymap > cryo_tpc_plane_keymap;
+
+  // Configuration read by the algorithm. Filled once by the module from its
+  // validated FHiCL table; defaults live only in the FHiCL description.
+  struct DisambigFromSpacePointsCfg {
+    bool useNeighbors;
+    size_t numNeighbors;
+    float maxDistance;
+    std::string moveLeftovers;
+    std::vector< size_t > excludeTPCs;
+  };
+
+  // One SpacePoint associated with a hit: its key in the SpacePoint collection
+  // and the object itself. Built at the module boundary from the hit-SpacePoint
+  // association; the pointer is valid only for the current event.
+  struct SpacePointRef {
+    size_t key;
+    recob::SpacePoint const* spacePoint;
+  };
+
+  // Counters written to the "hitstats" monitoring tree.
+  struct DisambigStats {
+    std::array<int, 3> nHits{};                // n all hits in each plane
+    std::array<int, 2> nMissedBySpacePoints{}; // n hits unresolved by SpacePoints in induction planes
+    std::array<int, 2> nMissedByNeighbors{};   // n hits unresolved by using neighboring hits (set only when useNeighbors)
+  };
+
+  // Hit-to-wire assignments; keys are indices into the input hit collection.
+  struct DisambigResult {
+    std::unordered_map< size_t, geo::WireID > hitToWire;                 // final hit-wire assignments
+    std::unordered_map< size_t, std::vector<geo::WireID> > hitToNWires;  // final hit-many-wires assignments
+    DisambigStats stats;
+  };
+
+  // Map induction SpacePoints to TPC by their collection hits.
+  // hitsPerSpacePoint[i]: hits associated with SpacePoint i.
+  std::unordered_map< size_t, size_t > mapSpacePointsToTPC(
+    std::vector< std::vector< recob::Hit const* > > const& hitsPerSpacePoint);
+
+  // Whole per-event computation.
+  // hits: the input hit collection.
+  // spacePointsPerHit[i]: SpacePoints associated with hits[i].
+  // hitsPerSpacePoint[j]: hits associated with SpacePoint j of the SpacePoint collection.
+  DisambigResult disambiguateHits(
+    DisambigFromSpacePointsCfg const& cfg,
+    std::vector< recob::Hit > const& hits,
+    std::vector< std::vector< SpacePointRef > > const& spacePointsPerHit,
+    std::vector< std::vector< recob::Hit const* > > const& hitsPerSpacePoint,
+    geo::WireReadoutGeom const& wireReadout,
+    detinfo::DetectorPropertiesData const& detProp);
+
+} // namespace dune
+
+#endif
